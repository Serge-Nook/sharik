{
  "name": "sharik",
  "productName": "Шарик",
  "version": "1.0.0",
  "description": "Шарик — продвинутый сканер IP-адресов. Сканирует диапазон IPv4 и показывает найденные устройства и информацию о них.",
  "author": {
    "name": "Горшков Сергей Владимирович",
    "email": "gorshkov.sv@example.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/Serge-Nook/sharik",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux deb AppImage",
    "dist:win": "electron-builder --win nsis",
    "dist:all": "electron-builder --linux deb AppImage --win nsis"
  },
  "build": {
    "appId": "ru.gorshkov.sharik",
    "productName": "Шарик",
    "copyright": "Copyright © 2026 Горшков Сергей Владимирович",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Sharik-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Шарик"
    },
    "linux": {
      "target": [
        { "target": "deb", "arch": ["x64"] },
        { "target": "AppImage", "arch": ["x64"] }
      ],
      "icon": "build/icons",
      "category": "Network",
      "synopsis": "Продвинутый сканер IP-адресов",
      "description": "Шарик — продвинутый сканер IP-адресов. Сканирует диапазон IPv4 и показывает найденные устройства и информацию о них.",
      "maintainer": "Горшков Сергей Владимирович <gorshkov.sv@example.com>",
      "artifactName": "Sharik-${version}.${ext}"
    },
    "deb": {
      "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1", "libsecret-1-0", "iputils-ping"]
    },
    "appImage": {
      "artifactName": "Sharik-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  }
}
